---
import Footer from '../../components/Footer.astro'
import Header from '../../components/Header.astro'
import ProjectCaseStudyDetails from '../../components/projects/ProjectCaseStudyDetails.astro'
import ProjectCaseStudyFooter from '../../components/projects/ProjectCaseStudyFooter.astro'
import ProjectCaseStudyHero from '../../components/projects/ProjectCaseStudyHero.astro'
import ProjectCaseStudyOverview from '../../components/projects/ProjectCaseStudyOverview.astro'
import SiteContainer from '../../components/SiteContainer.astro'
import { CDN_URL } from '../../constants'
import { projects } from '../../data/projects'
import Layout from '../../layouts/Layout.astro'
import type { Project } from '../../types'

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug ?? project.id },
    props: {
      project,
      nextProject: projects[(index + 1) % projects.length],
    },
  }))
}

interface Props {
  project: Project
  nextProject: Project
}

const { project, nextProject }: Props = Astro.props
const { name, description, caseStudy } = project

const imageId = project.imageId ?? project.id
const projectImageBase = `${CDN_URL}/projects/${imageId}`
const image = `${projectImageBase}/card-1920.webp`
const canonicalPath = `/projects/${project.slug ?? project.id}`
---

<Layout
  title={`${name} | Case Study — Jean Paul Fernandez`}
  description={description}
  canonicalPath={canonicalPath}
  image={image}
  imageAlt={`${name} project preview`}
  imageWidth={1920}
  imageHeight={1080}
>
  <Header variant='alt' />

  <main class='bg-page overflow-hidden pt-24 pb-20 lg:pt-30 lg:pb-28'>
    <SiteContainer>
      <ProjectCaseStudyHero project={project} />
      <ProjectCaseStudyOverview caseStudy={caseStudy} />
      <ProjectCaseStudyDetails caseStudy={caseStudy} />
      <ProjectCaseStudyFooter nextProject={nextProject} />
    </SiteContainer>
  </main>

  <Footer />
</Layout>
