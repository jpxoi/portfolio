---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import SiteContainer from '../components/SiteContainer.astro'
import { CDN_URL } from '../constants'

const imgAvif = `${CDN_URL}/portfolio/ui/ghost-img.avif`
const imgAvif2x = `${CDN_URL}/portfolio/ui/ghost-img@2x.avif`

const imgWebp = `${CDN_URL}/portfolio/ui/ghost-img.webp`
const imgWebp2x = `${CDN_URL}/portfolio/ui/ghost-img@2x.webp`

const imgFallback = imgWebp
---

<Layout>
  <Header variant='alt' />
  <main class='overflow-hidden'>
    <section class='bg-page xs:pt-36 grid h-dvh pt-28 pb-8'>
      <SiteContainer class='grid place-content-center gap-10 lg:grid-cols-2 lg:items-center lg:gap-8'>
        <div class='text-center lg:text-left'>
          <span class='text-copy-muted text-smaller'>Error 404</span>
          <h1 class='text-title text-display my-3'>Hey Buddy</h1>
          <p class='text-copy'>
            We can&apos;t seem to find the page <br /> you are looking for.
          </p>
          <a
            href='/'
            class='bg-primary text-page hover:bg-primary-alt transition-theme mt-8 inline-block rounded-full px-6 py-3.5 font-medium hover:shadow-[0_4px_12px_hsla(38,69%,8%,0.2)]'
          >
            Return to Home
          </a>
        </div>

        <div class='justify-self-center'>
          <picture>
            <source
              srcset={`${imgAvif} 500w, ${imgAvif2x} 1000w`}
              sizes='(min-width: 64rem) 25rem, 15.625rem'
              type='image/avif'
            />
            <source
              srcset={`${imgWebp} 500w, ${imgWebp2x} 1000w`}
              sizes='(min-width: 64rem) 25rem, 15.625rem'
              type='image/webp'
            />
            <img
              src={imgFallback}
              alt='Ghost Image'
              width={500}
              height={500}
              class='animate-p404-float w-62.5 motion-reduce:animate-none lg:w-100'
            />
          </picture>
          <div
            class='animate-p404-shadow mx-auto h-6 w-39 rounded-full bg-[hsla(38,21%,19%,0.16)] blur-sm motion-reduce:animate-none lg:h-10 lg:w-62.5'
            aria-hidden='true'
          >
          </div>
        </div>
      </SiteContainer>

      <footer class='text-copy-muted text-smaller self-end text-center'>
        <p>&copy; {new Date().getFullYear()} Jean Paul Fernandez</p>
      </footer>
    </section>
  </main>
</Layout>
