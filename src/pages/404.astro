---
import Layout from '../layouts/Layout.astro'
import '../styles/p404.css'
import Header from '../components/Header.astro'
import { CDN_URL } from '../constants'

const imgAvif = `${CDN_URL}/portfolio/ui/ghost-img.avif`
const imgWebp = `${CDN_URL}/portfolio/ui/ghost-img.webp`
const imgFallback = imgWebp
---

<Layout>
  <Header variant='alt' />
  <main class='overflow-hidden'>
    <section class='p404'>
      <div class='p404__container custom-container'>
        <div class='p404__data'>
          <span class='p404__subtitle'>Error 404</span>
          <h1 class='p404__title'>Hey Buddy</h1>
          <p class='p404__description'>
            We can&apos;t seem to find the page <br /> you are looking for.
          </p>
          <a href='/' class='p404__button'> Return to Home </a>
        </div>

        <div class='p404__img'>
          <picture>
            <source srcset={imgAvif} type='image/avif' />
            <source srcset={imgWebp} type='image/webp' />
            <img src={imgFallback} alt='Ghost Image' width={500} height={500} />
          </picture>
          <div class='p404__shadow'></div>
        </div>
      </div>
      <footer class='p404__footer'>
        <a target='_blank' rel='noreferrer' href='mailto:hello@jpxoi.com'><span>hello@jpxoi.com</span></a>
      </footer>
    </section>
  </main>
</Layout>
