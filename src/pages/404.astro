---
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import SiteContainer from '../components/SiteContainer.astro'
import { CDN_URL } from '../constants'

const imgAvif = `${CDN_URL}/portfolio/ui/ghost-img.avif`
const imgWebp = `${CDN_URL}/portfolio/ui/ghost-img.webp`
const imgFallback = imgWebp

const revealBase = 'opacity-0 motion-reduce:animate-none motion-reduce:opacity-100 motion-reduce:transform-none'
---

<Layout>
  <Header variant='alt' />
  <main class='overflow-hidden'>
    <section class='bg-page xs:pt-36 grid h-dvh pt-28 pb-8'>
      <SiteContainer class='grid place-content-center gap-10 lg:grid-cols-2 lg:items-center lg:gap-8'>
        <div class:list={[revealBase, 'text-center lg:text-left', 'animate-p404-reveal-top [animation-delay:50ms]']}>
          <span class='text-copy-muted text-smaller'>Error 404</span>
          <h1 class='text-title text-display my-3'>Hey Buddy</h1>
          <p class='text-copy'>
            We can&apos;t seem to find the page <br /> you are looking for.
          </p>
          <a
            href='/'
            class='bg-primary text-page hover:bg-primary-alt mt-8 inline-block rounded-full px-6 py-3.5 font-medium transition-[background-color,box-shadow] duration-300 hover:shadow-[0_4px_12px_hsla(38,69%,8%,0.2)]'
          >
            Return to Home
          </a>
        </div>

        <div class:list={[revealBase, 'justify-self-center', 'animate-p404-reveal-bottom [animation-delay:100ms]']}>
          <picture>
            <source srcset={imgAvif} type='image/avif' />
            <source srcset={imgWebp} type='image/webp' />
            <img
              src={imgFallback}
              alt='Ghost Image'
              width={500}
              height={500}
              class='animate-p404-float w-[230px] motion-reduce:animate-none lg:w-[400px]'
            />
          </picture>
          <div
            class='animate-p404-shadow mx-auto h-6 w-[130px] rounded-full bg-[hsla(38,21%,19%,0.16)] blur-[7px] motion-reduce:animate-none lg:h-10 lg:w-[250px]'
            aria-hidden='true'
          >
          </div>
        </div>
      </SiteContainer>

      <footer
        class:list={[
          revealBase,
          'text-copy-muted text-smaller self-end text-center',
          'animate-p404-reveal-bottom [animation-delay:200ms]',
        ]}
      >
        <p>&copy; {new Date().getFullYear()} Jean Paul Fernandez</p>
      </footer>
    </section>
  </main>
</Layout>
