---
import '../styles/global.css'
import { Font } from 'astro:assets'
import { CDN_URL } from '../constants'
import { buildThemeHeadScript } from '../lib/theme'

interface Props {
  title?: string
  description?: string
  canonicalPath?: string
  image?: string
  imageAlt?: string
  imageWidth?: number
  imageHeight?: number
}

const site = {
  name: 'Jean Paul Fernandez',
  title: 'Jean Paul Fernandez | Software Engineer',
  description:
    'Software engineer and Computer Science graduate from The University of Manchester, building scalable web platforms, APIs, AI-powered applications and React Native solutions for real-world business needs.',
  url: 'https://jpxoi.com/',
  domain: 'jpxoi.com',
  image: `${CDN_URL}/portfolio/opengraph/default.png`,
  imageAlt: "Preview of Jean Paul Fernandez's website",
  author: 'Jean Paul Fernandez',
  handle: '@jpxoi',
  keywords:
    'Jean Paul Fernandez, software engineer, full-stack software engineer, full-stack developer, computer science graduate, University of Manchester, Next.js developer, TypeScript developer, Python developer, React Native developer, AI applications, web development, backend systems, cloud infrastructure, product engineering',
}

const {
  title = site.title,
  description = site.description,
  canonicalPath = '/',
  image = site.image,
  imageAlt = site.imageAlt,
  imageWidth = 1200,
  imageHeight = 630,
}: Props = Astro.props

const canonicalUrl = new URL(canonicalPath, site.url).toString()
---

<html lang='en' class='dark bg-page scroll-smooth scheme-light dark:scheme-dark'>
  <head>
    <script is:inline set:html={buildThemeHeadScript()}></script>
    <Font cssVariable='--font-poppins' preload />
    <link rel='preconnect' href='https://cdn.jpxoi.com' crossorigin='' />
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />

    <link rel='icon' type='image/png' href='/favicon-96x96.png?v=20260602' sizes='96x96' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg?v=20260602' />
    <link rel='shortcut icon' href='/favicon.ico?v=20260602' />
    <link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png?v=20260602' />
    <meta name='apple-mobile-web-app-title' content='Jean Paul Fernandez' />
    <link rel='manifest' href='/site.webmanifest?v=20260602' />

    <link rel='canonical' href={canonicalUrl} />

    <title>{title}</title>
    <meta name='description' content={description} />
    <meta name='keywords' content={site.keywords} />
    <meta name='author' content={site.author} />
    <meta name='copyright' content={site.author} />

    <meta property='og:url' content={canonicalUrl} />
    <meta property='og:type' content='website' />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={image} />
    <meta property='og:image:width' content={String(imageWidth)} />
    <meta property='og:image:height' content={String(imageHeight)} />
    <meta property='og:image:alt' content={imageAlt} />
    <meta property='og:site_name' content={site.name} />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:image' content={image} />
    <meta name='twitter:image:alt' content={imageAlt} />
    <meta name='twitter:domain' content={site.domain} />
    <meta name='twitter:url' content={canonicalUrl} />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:site' content={site.handle} />
    <meta name='twitter:creator' content={site.handle} />
  </head>
  <body class='bg-page text-copy'>
    <slot />
  </body>
</html>
