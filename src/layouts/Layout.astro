---
import '../styles/global.css'
import { Font } from 'astro:assets'

const site = {
  name: 'Jean Paul Fernandez',
  title: 'Jean Paul Fernandez — Full-Stack Software Engineer',
  description:
    'Full-stack software engineer and Computer Science student at The University of Manchester, focused on building scalable web platforms, AI-powered applications and cloud-based digital products for real-world business needs.',
  url: 'https://jpxoi.com/',
  domain: 'jpxoi.com',
  image: 'https://cdn.jpxoi.com/media/uploads/social-card.webp',
  imageAlt: "Preview of Jean Paul Fernandez's website",
  author: 'Jean Paul Fernandez',
  handle: '@jpxoi',
  keywords:
    'Jean Paul Fernandez, software engineer, full-stack software engineer, full-stack developer, computer science student, University of Manchester, Next.js developer, TypeScript developer, Python developer, AI applications, web development, backend systems, cloud infrastructure, product engineering',
}
---

<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />

    <!--=============== SAFARI BAR COLOR ===============-->
    <meta name='theme-color' content='#fafcff' media='(prefers-color-scheme: light)' />
    <meta name='theme-color' content='#0b111e' media='(prefers-color-scheme: dark)' />

    <!--=============== FAVICON ===============-->
    <link rel='apple-touch-icon' sizes='180x180' href='/favicon/apple-touch-icon.png?v=2' />
    <link rel='icon' type='image/png' sizes='32x32' href='/favicon/favicon-32x32.png?v=2' />
    <link rel='icon' type='image/png' sizes='16x16' href='/favicon/favicon-16x16.png?v=2' />
    <link rel='manifest' href='/favicon/site.webmanifest?v=2' />
    <link rel='mask-icon' href='/favicon/safari-pinned-tab.svg?v=2' color='#0b111e' />
    <link rel='shortcut icon' href='/favicon/favicon.ico?v=2' />
    <meta name='msapplication-TileColor' content='#0b111e' />
    <meta name='msapplication-config' content='/favicon/browserconfig.xml?v=2' />

    <Font cssVariable='--font-poppins' preload />

    <!--=============== PRE-CONNECT ===============-->
    <link rel='preconnect' href='https://cdn.jpxoi.com' crossorigin />

    <!--=============== SEO ===============-->
    <link rel='canonical' href={site.url} />

    <!-- HTML Meta Tags -->
    <title>{site.title}</title>
    <meta name='description' content={site.description} />
    <meta name='keywords' content={site.keywords} />
    <meta name='author' content={site.author} />
    <meta name='copyright' content={site.author} />

    <!-- Facebook / Open Graph Meta Tags -->
    <meta property='og:url' content={site.url} />
    <meta property='og:type' content='website' />
    <meta property='og:title' content={site.title} />
    <meta property='og:description' content={site.description} />
    <meta property='og:image' content={site.image} />
    <meta property='og:image:alt' content={site.imageAlt} />
    <meta property='fb:app_id' content='4247685185353137' />
    <meta name='facebook-domain-verification' content='i9ntff10jcz1nlu4myciodpcr6trdv' />

    <!-- Twitter Meta Tags -->
    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:domain' content={site.domain} />
    <meta name='twitter:url' content={site.url} />
    <meta name='twitter:title' content={site.title} />
    <meta name='twitter:description' content={site.description} />
    <meta name='twitter:image' content={site.image} />
    <meta name='twitter:image:alt' content={site.imageAlt} />
    <meta name='twitter:site' content={site.handle} />
    <meta name='twitter:creator' content={site.handle} />
  </head>
  <body>
    <script is:inline>
      ;(function () {
        var version = localStorage.getItem('theme-storage-version')
        var stored = localStorage.getItem('selected-theme')
        if (!stored) return
        var light = version === '2' ? stored === 'light' : stored === 'dark'
        if (light) document.body.classList.add('light-theme')
      })()
    </script>
    <slot />
  </body>
</html>
