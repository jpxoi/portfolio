---
import FooterList from './FooterList.astro'
import FooterSocial from './FooterSocial.astro'
---

<footer class='footer'>
  <div class='custom-container grid gap-5! py-8 pb-24'>
    <h2 class='footer__title'>Jean Paul Fernandez</h2>
    <FooterList />
    <FooterSocial />
    <span class='footer__copy my-8 block text-center'>
