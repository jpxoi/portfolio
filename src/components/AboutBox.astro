---
import type { AboutInfo } from '../types'

interface Props extends AboutInfo {}

const { icon: Icon, title, subtitle }: Props = Astro.props
---

<div class='about__box'>
  <Icon className='mb-2 size-6 justify-self-center' color='var(--first-color)' />
  <h3 class='text-(length:--small-font-size)'>{title}</h3>
  <span class='text-(length:--tiny-font-size) font-normal text-(--text-color-light)'>{subtitle}</span>
</div>
