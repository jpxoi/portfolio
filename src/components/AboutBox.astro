---
import type { AboutInfo } from '../types'

interface Props extends AboutInfo {}

const { icon: Icon, title, subtitle }: Props = Astro.props
---

<div
  class='bg-surface rounded-xl px-2 py-3 text-center shadow-[0_2px_8px_hsla(var(--second-hue),48%,8%,0.1)] lg:px-5 lg:py-4'
>
  <Icon className='text-primary mb-2 size-6 justify-self-center' color='currentColor' />
  <h3 class='text-small'>{title}</h3>
  <span class='text-copy-muted text-tiny font-normal'>{subtitle}</span>
</div>
