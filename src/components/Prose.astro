---
const proseClass = [
  'text-body leading-relaxed text-copy',
  '[&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:scroll-mt-28 [&_h2]:text-h2 [&_h2]:font-semibold [&_h2]:text-primary',
  '[&_h3]:mt-6 [&_h3]:mb-2 [&_h3]:text-h3 [&_h3]:font-semibold [&_h3]:text-title',
  '[&_p]:mb-4 [&_p]:text-pretty',
  '[&_li]:mb-2 [&_li]:text-pretty',
  '[&_ul]:mb-4 [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5',
  '[&_strong]:font-semibold [&_strong]:text-title',
  '[&_code]:text-title [&_code]:font-medium',
  '[&_a]:font-medium [&_a]:text-primary [&_a]:underline-offset-2 [&_a:hover]:underline',
].join(' ')
---

<div class={proseClass}>
  <slot />
</div>
