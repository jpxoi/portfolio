---
import { projects } from '../data/projects'
import ProjectCard from './ProjectCard.astro'
import PageSection from './PageSection.astro'
import SectionHeading from './SectionHeading.astro'
import SiteContainer from './SiteContainer.astro'
---

<PageSection id='projects' class='projects'>
  <SectionHeading subtitle='My Work' title='Projects' />
  <SiteContainer class='grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 lg:gap-12'>
    {projects.map((project) => <ProjectCard {...project} />)}
  </SiteContainer>
</PageSection>
