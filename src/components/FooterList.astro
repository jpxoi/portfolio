---
const footerList = [
  {
    id: 'footer-link-1',
    title: 'About',
    link: '#about',
    target_blank: false,
  },
  {
    id: 'footer-link-2',
    title: 'Store',
    link: 'https://store.jpxoi.com',
    target_blank: true,
  },
  {
    id: 'footer-link-3',
    title: 'Donate',
    link: 'https://www.paypal.com/donate/?hosted_button_id=7FLJ7WSKMAYTQ',
    target_blank: true,
  },
  {
    id: 'footer-link-4',
    title: 'Customer Portal',
    link: 'https://billing.stripe.com/p/login/14k3ez8zT1YR6qcfYY',
    target_blank: true,
  },
]

const linkClass =
  'text-(length:--small-font-size) font-medium text-copy transition-theme hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'
---

<nav aria-label='Footer'>
  <ul
    class='flex flex-wrap items-center justify-center gap-x-5 gap-y-2 sm:gap-x-6 lg:flex-col lg:items-end lg:gap-x-0 lg:gap-y-3'
  >
    {
      footerList.map((item) => (
        <li>
          <a
            id={item.id}
            href={item.link}
            target={item.target_blank ? '_blank' : undefined}
            rel={item.target_blank ? 'noopener noreferrer' : undefined}
            class={linkClass}
          >
            {item.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
