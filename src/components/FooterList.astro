---
const primaryLinks = [
  {
    id: 'footer-link-1',
    title: 'Projects',
    link: '/#projects',
  },
  {
    id: 'footer-link-2',
    title: 'About',
    link: '/#about',
  },
  {
    id: 'footer-link-3',
    title: 'Contact',
    link: '/#contact',
  },
  {
    id: 'footer-link-4',
    title: 'Privacy',
    link: '/privacy',
  },
]

const clientPortalUrl = 'https://billing.stripe.com/p/login/14k3ez8zT1YR6qcfYY'

const linkClass =
  'text-small font-medium text-copy transition-theme hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'

const secondaryLinkClass =
  'text-smaller text-copy-muted transition-theme hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'
---

<nav class='flex flex-col items-center gap-3 lg:items-end' aria-label='Footer'>
  <ul class='flex flex-wrap items-center justify-center gap-x-5 gap-y-2 sm:gap-x-6 lg:justify-end'>
    {primaryLinks.map((item) => (
      <li>
        <a id={item.id} href={item.link} class={linkClass}>
          {item.title}
        </a>
      </li>
    ))}
  </ul>

  <a href={clientPortalUrl} target='_blank' rel='noopener noreferrer' class={secondaryLinkClass}>
    Customer Portal
  </a>
</nav>
