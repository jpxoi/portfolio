---
import type { Contact } from '../types'
import { ArrowRightStroke } from '@boxicons/react'

interface Props extends Contact {}

const { id, title, link, cta, icon: Icon }: Props = Astro.props
---

<a
  href={link}
  target='_blank'
  rel='noopener noreferrer'
  class='group focus-visible:outline-primary [@media(hover:hover)]:hover:bg-surface/50 -mx-2 flex items-center gap-3 rounded-md px-2 py-3 transition-[background-color,color,transform] duration-(--theme-transition-duration) ease-(--theme-transition-timing) focus-visible:outline-2 focus-visible:outline-offset-2'
>
  <Icon id={id} className='text-primary size-6 shrink-0' color='currentColor' aria-hidden='true' />
  <span class='min-w-0 flex-1 text-left'>
    <span class='text-title text-small block font-medium'>{title}</span>
    <span class='text-primary text-tiny block'>{cta}</span>
  </span>
  <ArrowRightStroke
    className='text-copy-muted [@media(hover:hover)]:group-hover:text-primary size-5 shrink-0 transition-[transform,color] duration-(--theme-transition-duration) ease-(--theme-transition-timing) [@media(hover:hover)]:group-hover:translate-x-0.5'
    aria-hidden='true'
  />
</a>
