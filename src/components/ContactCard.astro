---
import type { Contact } from '../types'
import { ArrowRightStroke } from '@boxicons/react'

interface Props extends Contact {}

const { id, title, link, cta, icon: Icon }: Props = Astro.props
---

<div class='contact__card'>
  <Icon id={id} className='mb-1 size-8 justify-self-center' color='var(--title-color)' />
  <h4 class='contact__card-title'>{title}</h4>

  <a href={link} target='_blank' rel='noreferrer' class='group contact__button'>
    {cta}
    <ArrowRightStroke className='size-5 transition-transform duration-200 ease-in-out group-hover:translate-x-0.5' />
  </a>
</div>
