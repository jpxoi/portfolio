---
interface Props {
  variant?: 'solid' | 'ghost'
  href?: string
  type?: 'button' | 'submit' | 'reset'
  class?: string
  download?: string | boolean
  target?: string
  rel?: string
  [key: string]: unknown
}

const { variant = 'solid', href, type = 'button', class: className, download, target, rel, ...restProps } = Astro.props

const baseClass =
  'inline-flex cursor-pointer items-center justify-center rounded-full border px-5 py-2.5 text-small font-medium transition-theme focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'

const variantClass =
  variant === 'ghost'
    ? 'border-copy-muted/15 bg-nav-glass text-copy shadow-nav-glass backdrop-blur-lg hover:border-copy-muted/30 hover:text-primary'
    : 'border-transparent bg-primary text-page hover:bg-primary-alt hover:text-page'

const classes = [baseClass, variantClass, className].filter(Boolean)
---

{
  href ? (
    <a href={href} class:list={classes} download={download} target={target} rel={rel} {...restProps}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...restProps}>
      <slot />
    </button>
  )
}
