---
import PageSection from './PageSection.astro'
import SectionHeading from './SectionHeading.astro'
import SiteContainer from './SiteContainer.astro'
import { CDN_URL } from '../constants'

const imgAvif = `${CDN_URL}/portfolio/about/about.avif`
const imgAvif2x = `${CDN_URL}/portfolio/about/about@2x.avif`

const imgWebp = `${CDN_URL}/portfolio/about/about.webp`
const imgWebp2x = `${CDN_URL}/portfolio/about/about@2x.webp`

const imgFallback = imgWebp
---

<PageSection id='about' class='pt-10! lg:pt-14!'>
  <SectionHeading subtitle='Who I Am' title='About Me' />

  <SiteContainer class='grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-x-16'>
    <picture class='animate-floaty xs:w-55 mx-auto block w-32.5 justify-self-center rounded-3xl motion-reduce:animate-none lg:mx-0 lg:w-87.5'>
      <source srcset={`${imgAvif} 1x, ${imgAvif2x} 2x`} type='image/avif' />
      <source srcset={`${imgWebp} 1x, ${imgWebp2x} 2x`} type='image/webp' />
      <img
        loading='lazy'
        src={imgFallback}
        alt='Memoji of Jean Paul Fernandez'
        width={350}
        height={350}
        class='h-auto w-full'
      />
    </picture>

    <div class='mx-auto max-w-xl text-center lg:mx-0 lg:text-left'>
      <p class='text-copy text-small mb-4 leading-relaxed text-pretty lg:mb-6'>
        I&apos;m a software engineer and Computer Science graduate from The University of Manchester. I enjoy turning
        complex operational problems into software that feels clear, dependable and genuinely useful to the people
        working with it.
      </p>
      <p class='text-copy-muted text-small leading-relaxed text-pretty'>
        My work sits between engineering and product: understanding how a business actually operates, making thoughtful
        technical decisions and carrying an idea through to a maintainable product that teams can rely on.
      </p>
    </div>
  </SiteContainer>
</PageSection>
