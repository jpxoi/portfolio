---
import { aboutInfo } from '../data/about'
import AboutBox from './AboutBox.astro'
import { STATIC_CONTENT_URL } from '../constants'

const imgAvif = `${STATIC_CONTENT_URL}/media/images/profile/about.avif`
const imgWebp = `${STATIC_CONTENT_URL}/media/images/profile/about.webp`
const imgFallback = imgWebp
---

<section class='about section' id='about'>
  <h2 class='section__title'>About Me</h2>

  <div class='about__container custom-container grid gap-5!'>
    <picture class='about__img'>
      <source srcset={imgAvif} type='image/avif' />
      <source srcset={imgWebp} type='image/webp' />
      <img loading='lazy' src={imgFallback} alt='Memoji of Jean Paul Fernandez' width={350} height={350} />
    </picture>
    <div class='about__data'>
      <div class='about__info'>
        {aboutInfo.map((info) => <AboutBox {...info} />)}
      </div>

      <p class='about__description text-pretty'>
        Full-stack software engineer and Computer Science student at The University of Manchester, focused on building
        scalable web platforms, AI-powered applications and cloud-based digital products.
      </p>
      <p class='about__description text-pretty'>
        I work across modern web technologies, backend systems, databases and infrastructure, combining technical
        problem-solving with a product-oriented approach to create practical, reliable and user-focused software for
        real-world business needs.
      </p>
    </div>
  </div>
</section>
