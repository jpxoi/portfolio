---
import { heroSocialLinks } from '../data/socials'
import { CAL_BOOKING_LINK, CAL_BOOKING_NAMESPACE, CAL_EMBED_CONFIG, CDN_URL } from '../constants'
import { HERO_LONGEST_ROLE, HERO_ROLES } from '../lib/hero-typewriter'
import Button from './Button.astro'
import CalEmbedProvider from './CalEmbedProvider.astro'
import HeroSocialLink from './HeroSocialLink.astro'
import PageSection from './PageSection.astro'
import SiteContainer from './SiteContainer.astro'

const imgAvif = `${CDN_URL}/portfolio/about/profile.avif`
const imgAvif2x = `${CDN_URL}/portfolio/about/profile@2x.avif`

const imgWebp = `${CDN_URL}/portfolio/about/profile.webp`
const imgWebp2x = `${CDN_URL}/portfolio/about/profile@2x.webp`

const imgFallback = imgWebp
const calConfig = JSON.stringify(CAL_EMBED_CONFIG)

const handleClass =
  'border-copy-muted/12 bg-nav-glass shadow-nav-glass relative flex aspect-4/5 w-full max-w-60 flex-col justify-end overflow-hidden rounded-3xl border backdrop-blur-lg transition-theme sm:max-w-68 lg:max-w-75 xl:max-w-80'
---

<PageSection id='home' class='pb-6! lg:pb-12!'>
  <SiteContainer class='pt-8 pb-0 lg:py-16'>
    <div class='lg:grid lg:min-h-112 lg:grid-cols-2 lg:items-center lg:gap-x-16 xl:gap-x-20'>
      <div class='text-center lg:text-left'>
        <span class='text-copy-muted text-smaller mb-2 block font-semibold tracking-[0.12em] uppercase'>
          Hello, I&apos;m
        </span>
        <h1 class='text-display text-title leading-tight'>Jean Paul Fernandez</h1>

        <h2
          class='text-primary text-small mt-3 mb-6 grid font-medium transition-opacity duration-500 ease-in-out lg:mb-7'
          aria-live='polite'
        >
          <span class='invisible col-start-1 row-start-1 block' aria-hidden='true'>{HERO_LONGEST_ROLE}</span>
          <span id='dynamic-header' class='col-start-1 row-start-1 block'>{HERO_ROLES[0]}</span>
        </h2>

        <div class='flex flex-col items-center gap-5 lg:items-start'>
          <div class='xs:flex-row flex w-full max-w-xs flex-col justify-center gap-3 sm:max-w-none lg:justify-start'>
            <Button
              class='xs:w-auto w-full justify-center'
              data-cal-link={CAL_BOOKING_LINK}
              data-cal-namespace={CAL_BOOKING_NAMESPACE}
              data-cal-config={calConfig}
            >
              Let&apos;s Talk
            </Button>

            <Button
              href={`${CDN_URL}/documents/Jean_Paul_Fernandez_CV.pdf`}
              target='_blank'
              download='Jean_Paul_Fernandez_CV.pdf'
              rel='noreferrer'
              variant='ghost'
              class='xs:w-auto w-full justify-center'
            >
              Download CV
            </Button>
          </div>

          <div class='flex flex-wrap items-center justify-center gap-2 lg:justify-start'>
            {heroSocialLinks.map((link) => <HeroSocialLink {...link} />)}
          </div>
        </div>
      </div>

      <div class='mt-8 flex justify-center lg:mt-0 lg:justify-end'>
        <div class={handleClass}>
          <div
            class='from-primary/20 via-primary/5 pointer-events-none absolute inset-0 bg-linear-to-t to-transparent'
            aria-hidden='true'
          >
          </div>
          <picture class='relative z-1 mx-auto block w-10/12 leading-none'>
            <source srcset={`${imgAvif} 1x, ${imgAvif2x} 2x`} type='image/avif' />
            <source srcset={`${imgWebp} 1x, ${imgWebp2x} 2x`} type='image/webp' />
            <img
              loading='eager'
              fetchpriority='high'
              src={imgFallback}
              alt='Memoji of Jean Paul Fernandez waving'
              width={336}
              height={420}
              class='block h-auto w-full'
            />
          </picture>
        </div>
      </div>
    </div>
  </SiteContainer>
</PageSection>

<script>
  import { initHeroTypewriter } from '../lib/hero-typewriter'
  initHeroTypewriter()
</script>

<CalEmbedProvider />
