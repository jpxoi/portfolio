---
import { heroSocialLinks } from '../data/socials'
import { CDN_URL } from '../constants'
import Button from './Button.astro'
import HeroSocialLink from './HeroSocialLink.astro'
import PageSection from './PageSection.astro'
import SiteContainer from './SiteContainer.astro'
import { Mouse } from '@boxicons/react'

const imgAvif = `${CDN_URL}/portfolio/about/profile.avif`
const imgWebp = `${CDN_URL}/portfolio/about/profile.webp`
const imgFallback = imgWebp

const handleClass =
  'flex aspect-[290/400] justify-self-center items-end justify-center overflow-hidden bg-gradient-to-b from-primary to-primary-fade !rounded-t-[10rem] !rounded-b-2xl w-full max-w-[200px] sm:max-w-3xs md:max-w-[290px]'

const imgClass = 'w-full max-w-[75%]'
const socialRailClass =
  'flex flex-col items-center justify-self-start gap-2.5 self-end pb-4 text-primary sm:pb-6 lg:pb-8'
const scrollRailClass =
  'transition-theme flex flex-col items-center justify-self-end gap-3 self-end pb-4 text-primary sm:pb-6 lg:pb-8'
---

<PageSection id='home'>
  <SiteContainer class='pt-8'>
    <div class='grid gap-18'>
      <div class='text-center'>
        <span class='text-title text-small mb-1 block font-medium'>Hello, I&apos;m</span>
        <h1 class='text-display leading-tight'>Jean Paul Fernandez</h1>
        <h2
          id='dynamic-header'
          class='text-copy text-small mb-10 min-h-6 font-medium transition-opacity duration-500 ease-in-out'
        >
          Software Engineer
        </h2>

        <div class='xs:flex-row xs:gap-4 flex flex-col items-center justify-center gap-2'>
          <Button
            href={`${CDN_URL}/documents/Jean_Paul_Fernandez_CV.pdf`}
            target='_blank'
            download='Jean_Paul_Fernandez_CV.pdf'
            rel='noreferrer'
            variant='ghost'
          >
            Download CV
          </Button>

          <Button href='#about'>About Me</Button>
        </div>
      </div>

      <div class='flex w-full items-end justify-between gap-x-3 sm:gap-x-6 lg:gap-x-10'>
        <div class={socialRailClass}>
          {heroSocialLinks.map((link) => <HeroSocialLink {...link} />)}
          <span class='bg-primary mt-1 h-8 w-0.5' aria-hidden='true'></span>
        </div>

        <div class={handleClass}>
          <picture class={imgClass}>
            <source srcset={imgAvif} type='image/avif' />
            <source srcset={imgWebp} type='image/webp' />
            <img
              loading='eager'
              fetchpriority='high'
              src={imgFallback}
              alt='Stand up Memoji of Jean Paul Fernandez'
              width={220}
              height={381.05}
            />
          </picture>
        </div>

        <a href='#about' class={scrollRailClass}>
          <Mouse className='size-6' />
          <span class='text-smaller [text-orientation:mixed] [writing-mode:vertical-rl]'> Scroll Down </span>
        </a>
      </div>
    </div>
  </SiteContainer>
</PageSection>

<script>
  const headerTexts = ['Software Engineer', 'Full-stack Developer', 'AI Engineer']
  const headerEl = document.getElementById('dynamic-header')

  if (headerEl) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      headerEl.textContent = headerTexts[0]
    } else {
      const el = headerEl
      let textIndex = 0
      let charIndex = headerTexts[0].length - 1
      let isDeleting = false
      const pauseAfterTyped = 2000

      function randomBetween(min: number, max: number) {
        return Math.floor(Math.random() * (max - min + 1) + min)
      }

      function typeWriter() {
        const fullText = headerTexts[textIndex]
        let delay

        if (!isDeleting) {
          el.textContent = fullText.substring(0, charIndex + 1)
          charIndex++
          if (charIndex === fullText.length) {
            isDeleting = true
            setTimeout(typeWriter, pauseAfterTyped)
            return
          }
          delay = randomBetween(60, 80)
        } else {
          el.textContent = fullText.substring(0, charIndex - 1)
          charIndex--
          if (charIndex === 0) {
            isDeleting = false
            textIndex = (textIndex + 1) % headerTexts.length
          }
          delay = randomBetween(80, 100)
        }
        setTimeout(typeWriter, delay)
      }

      typeWriter()
    }
  }
</script>
