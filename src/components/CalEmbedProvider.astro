---
import {
  CAL_BOOKING_NAMESPACE,
  CAL_BRAND_DARK,
  CAL_BRAND_LIGHT,
  CAL_EMBED_CONFIG,
  CAL_EMBED_ORIGIN,
  CAL_EMBED_SCRIPT_URL,
} from '../constants'

const calUiConfig = {
  cssVarsPerTheme: {
    light: { 'cal-brand': CAL_BRAND_LIGHT },
    dark: { 'cal-brand': CAL_BRAND_DARK },
  },
  hideEventTypeDetails: false,
  layout: CAL_EMBED_CONFIG.layout,
} as const

const calInlineScript = `;(function(C,A,L){let p=function(a,ar){a.q.push(ar)};let d=C.document;C.Cal=C.Cal||function(){let cal=C.Cal;let ar=arguments;if(!cal.loaded){cal.ns={};cal.q=cal.q||[];d.head.appendChild(d.createElement('script')).src=A;cal.loaded=true}if(ar[0]===L){const api=function(){p(api,arguments)};const namespace=ar[1];api.q=api.q||[];if(typeof namespace==='string'){cal.ns[namespace]=cal.ns[namespace]||api;p(cal.ns[namespace],ar);p(cal,['initNamespace',namespace])}else p(cal,ar);return}p(cal,ar)}})(window,${JSON.stringify(CAL_EMBED_SCRIPT_URL)},'init');Cal('init',${JSON.stringify(CAL_BOOKING_NAMESPACE)},{origin:${JSON.stringify(CAL_EMBED_ORIGIN)}});Cal.ns[${JSON.stringify(CAL_BOOKING_NAMESPACE)}]('ui',${JSON.stringify(calUiConfig)})`
---

<script is:inline set:html={calInlineScript} />
