---
import type { HeroSocialLink } from '../types'

interface Props extends HeroSocialLink {}

const { route, icon: Icon, aria_label }: Props = Astro.props
---

<a
  href={route}
  target='_blank'
  rel='noreferrer'
  class='transition-theme bg-surface text-primary hover:bg-primary flex w-max rounded p-1 text-base shadow-[0_2px_8px_hsla(var(--second-hue),48%,8%,0.1)] hover:text-white lg:p-1.5 lg:text-xl'
  aria-label={aria_label}
>
  <Icon className='size-5' />
  <span class='hidden'>{aria_label}</span>
</a>
