---
import type { HeroSocialLink } from '../types'

interface Props extends HeroSocialLink {}

const { route, icon: Icon, aria_label, label }: Props = Astro.props
---

<a
  href={route}
  target='_blank'
  rel='noreferrer'
  class='text-copy-muted hover:text-primary transition-theme border-copy-muted/10 hover:border-copy-muted/20 bg-surface/15 hover:bg-surface/30 text-tiny inline-flex cursor-pointer items-center gap-1.5 rounded-full border px-3 py-1.5 font-normal'
  aria-label={aria_label}
>
  <Icon className='size-4 shrink-0 opacity-80' color='currentColor' />
  <span>{label}</span>
</a>
