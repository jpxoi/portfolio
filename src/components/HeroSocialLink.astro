---
import type { HeroSocialLink } from '../types'

interface Props extends HeroSocialLink {}

const { route, icon: Icon, aria_label }: Props = Astro.props
---

<a href={route} target='_blank' rel='noreferrer' class='home__social-link' aria-label={aria_label}>
  <Icon className='size-5' />
  <span class='hidden'>{aria_label}</span>
</a>
