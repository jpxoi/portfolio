---
interface Props {
  name: string
  icon: string
  alticon?: string
  invertInDark?: boolean
  hideFromAssistiveTech?: boolean
}

const { name, icon, alticon, invertInDark, hideFromAssistiveTech }: Props = Astro.props

const baseIconClass = 'size-10 drop-shadow-sm transition-transform duration-200 ease-out group-hover/tile:scale-105'

const lightOnlyIconClass = [baseIconClass, 'dark:hidden']
const darkOnlyIconClass = [baseIconClass, 'hidden dark:block', invertInDark && 'dark:brightness-0 dark:invert']
const singleIconClass = [baseIconClass, invertInDark && 'dark:brightness-0 dark:invert']
const iconAttributes = {
  loading: 'lazy' as const,
  decoding: 'async' as const,
  width: 40,
  height: 40,
}
---

<div
  class='skill-tile group/tile flex w-16 min-w-18 shrink-0 flex-col items-center gap-1.5'
  aria-hidden={hideFromAssistiveTech ? true : undefined}
>
  <div class='flex size-10 items-center justify-center'>
    {
      alticon ? (
        <>
          <img {...iconAttributes} src={alticon} alt='' class:list={lightOnlyIconClass} />
          <img {...iconAttributes} src={icon} alt='' class:list={darkOnlyIconClass} />
        </>
      ) : (
        <img {...iconAttributes} src={icon} alt='' class:list={singleIconClass} />
      )
    }
  </div>
  <span
    class='transition-theme text-copy-muted text-tiny group-hover/tile:text-copy line-clamp-2 w-full text-center leading-snug'
  >
    {name}
  </span>
</div>
