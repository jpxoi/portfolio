---
interface Props {
  name: string
  icon: string
  alticon?: string
  invertInDark?: boolean
  hideFromAssistiveTech?: boolean
}

const { name, icon, alticon, invertInDark, hideFromAssistiveTech }: Props = Astro.props
---

<div
  class='skill-tile group/tile flex w-16 min-w-18 shrink-0 flex-col items-center gap-1.5'
  aria-hidden={hideFromAssistiveTech ? true : undefined}
>
  <div class='flex size-10 items-center justify-center'>
    <img
      loading='lazy'
      data-icon={icon}
      data-alticon={alticon}
      src={icon}
      alt=''
      class:list={[
        'size-10 drop-shadow-sm transition-transform duration-200 ease-out [@media(hover:hover)]:group-hover/tile:scale-105',
        invertInDark && 'dark:brightness-0 dark:invert',
      ]}
    />
  </div>
  <span
    class='line-clamp-2 w-full text-center text-(length:--tiny-font-size) leading-snug text-(--text-color-light) transition-theme [@media(hover:hover)]:group-hover/tile:text-(--text-color)'
  >
    {name}
  </span>
</div>
