---
import { contactData } from '../data/contact'
import Button from './Button.astro'
import ContactCard from './ContactCard.astro'
import PageSection from './PageSection.astro'
import SectionHeading from './SectionHeading.astro'
import SiteContainer from './SiteContainer.astro'

const formInputClass =
  'contact__form-input transition-theme focus-visible:border-primary focus-visible:outline-none resize-none'
---

<PageSection id='contact'>
  <SectionHeading subtitle='Get In Touch' title='Contact Me' />

  <SiteContainer class='grid gap-10 pb-12 lg:grid-cols-2 lg:items-start lg:gap-x-14'>
    <div>
      <h3 class='text-h3 mb-6 text-center lg:text-left'>Talk to me</h3>
      <div class='flex flex-col gap-1'>
        {contactData.map((contactCard) => <ContactCard {...contactCard} />)}
      </div>
    </div>

    <div>
      <h3 class='text-h3 mb-6 text-center lg:text-left'>Write me about your project</h3>

      <form
        action='https://formcarry.com/s/IdMAAJSEpJf'
        method='POST'
        enctype='multipart/form-data'
        class='w-full'
        name='contactForm'
      >
        <div class='absolute left-[-9999px] h-0 w-0 overflow-hidden' aria-hidden='true'>
          <label for='contact-honeypot'>Leave empty</label>
          <input type='text' id='contact-honeypot' name='_gotcha' tabindex='-1' autocomplete='off' />
        </div>

        <div class='relative mb-8 h-16'>
          <label for='name' class='contact__form-tag'>Full Name</label>
          <input
            type='text'
            placeholder='Insert your name'
            class={formInputClass}
            id='name'
            name='name'
            autocomplete='name'
            required
          />
        </div>

        <div class='relative mb-8 h-16'>
          <label for='email' class='contact__form-tag'>Email</label>
          <input
            type='email'
            placeholder='Insert your email'
            class={formInputClass}
            id='email'
            name='email'
            autocomplete='email'
            required
          />
        </div>

        <div class='relative mb-8 h-44'>
          <label for='message' class='contact__form-tag'>Message</label>
          <textarea
            placeholder='Describe your project'
            class={formInputClass}
            id='message'
            name='message'
            cols='30'
            rows='10'
            required></textarea>
        </div>

        <Button type='submit' class='w-full sm:w-auto'>Send Message</Button>
      </form>
    </div>
  </SiteContainer>
</PageSection>
