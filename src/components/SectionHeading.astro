---
interface Props {
  title: string
  subtitle?: string
}

const { title, subtitle }: Props = Astro.props
---

{
  subtitle ? (
    <span class='text-copy dark:text-copy-muted block text-center text-(length:--smaller-font-size)'>{subtitle}</span>
  ) : null
}
<h2 class='text-primary mb-8 text-center text-(length:--h2-font-size) lg:mb-14'>{title}</h2>
