---
import { footerSocialData } from '../data/socials'

const socialLinkClass =
  'inline-flex size-11 items-center justify-center rounded-lg text-(--text-color-light) transition-[color,background-color] duration-200 hover:bg-(--first-color)/10 hover:text-(--first-color) focus-visible:bg-(--first-color)/10 focus-visible:text-(--first-color) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--first-color)'
---

<ul class='flex items-center justify-center gap-2 lg:justify-end lg:gap-3'>
  {
    footerSocialData.map(({ icon: Icon, ...social }) => (
      <li>
        <a href={social.link} target='_blank' rel='noopener noreferrer' class={socialLinkClass} aria-label={social.alt}>
          <Icon className='size-6' color='currentColor' aria-hidden='true' />
        </a>
      </li>
    ))
  }
</ul>
