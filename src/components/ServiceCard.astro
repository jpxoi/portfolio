---
import { ArrowRightStroke, CheckCircle, X } from '@boxicons/react'

interface Props {
  title: string
  description: string
  modalId: string
  items: {
    title: string
    description: string
  }[]
}

const { title, description, modalId, items }: Props = Astro.props
const titleId = `${modalId}-title`
---

<div
  class='transition-theme bg-surface flex h-full flex-col rounded-2xl p-6 shadow-[0_2px_16px_hsla(var(--second-hue),48%,8%,0.1)] sm:p-8'
>
  <h3 class='text-h3 mb-6 text-balance'>{title}</h3>

  <button
    type='button'
    class='group transition-theme text-primary text-small focus-visible:outline-primary mt-auto flex cursor-pointer items-center gap-x-1 border-0 bg-transparent p-0 font-[inherit] focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2'
    command='show-modal'
    commandfor={modalId}
    aria-haspopup='dialog'
    aria-label={`See more about ${title}`}
  >
    See More
    <ArrowRightStroke
      className='size-5 transition-transform duration-200 ease-in-out group-hover:translate-x-0.5'
      aria-hidden='true'
    />
  </button>

  <dialog
    class='services__modal m-auto overflow-visible border-0 bg-transparent opacity-0 motion-reduce:transform-none motion-reduce:opacity-100 motion-reduce:transition-none'
    id={modalId}
    closedby='any'
    aria-labelledby={titleId}
  >
    <div
      class='transition-theme bg-page relative max-h-[90dvh] rounded-3xl px-6 pt-18 pb-10 sm:w-125 sm:px-10 md:w-150 lg:w-175'
    >
      <button
        type='button'
        class='transition-theme text-primary focus-visible:outline-primary absolute top-6 right-6 cursor-pointer border-0 bg-transparent p-0 focus-visible:rounded focus-visible:outline-2 focus-visible:outline-offset-2'
        command='close'
        commandfor={modalId}
        aria-label={`Close ${title} details`}
      >
        <X className='size-5' color='currentColor' aria-hidden='true' />
      </button>
      <div class='max-h-[75dvh] overflow-scroll'>
        <h4 class='text-primary text-h3 mb-4 text-center' id={titleId}>{title}</h4>

        <p class='text-small mb-8 text-center text-pretty sm:px-14'>{description}</p>

        <ul class='grid gap-y-3'>
          {
            items.map(({ title, description }) => (
              <li class='flex items-start gap-x-2'>
                <CheckCircle className='size-5 min-w-5 text-primary' color='currentColor' aria-hidden='true' />
                <p class='text-small text-pretty'>
                  <b>{title}:</b> {description}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </dialog>
</div>
