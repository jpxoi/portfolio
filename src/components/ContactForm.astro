---
import Button from './Button.astro'

const formInputClass =
  'border-input-border text-copy transition-theme focus-visible:border-primary absolute top-0 left-0 z-1 h-full w-full resize-none rounded-xl border-2 border-solid p-6 focus-visible:outline-none'

const formLabelClass = 'text-smaller bg-page transition-theme absolute -top-3 left-5 z-10 p-1'
---

<div>
  <h3 class='text-h3 mb-6 text-center lg:text-left'>Write me about your project</h3>

  <form
    action='https://formcarry.com/s/IdMAAJSEpJf'
    method='POST'
    enctype='multipart/form-data'
    class='w-full'
    name='contactForm'
  >
    <div class='absolute left-[-9999px] h-0 w-0 overflow-hidden' aria-hidden='true'>
      <label for='contact-honeypot'>Leave empty</label>
      <input type='text' id='contact-honeypot' name='_gotcha' tabindex='-1' autocomplete='off' />
    </div>

    <div class='relative mb-8 h-16'>
      <label for='name' class={formLabelClass}>Full Name</label>
      <input
        type='text'
        placeholder='Insert your name'
        class={formInputClass}
        id='name'
        name='name'
        autocomplete='name'
        required
      />
    </div>

    <div class='relative mb-8 h-16'>
      <label for='email' class={formLabelClass}>Email</label>
      <input
        type='email'
        placeholder='Insert your email'
        class={formInputClass}
        id='email'
        name='email'
        autocomplete='email'
        required
      />
    </div>

    <div class='relative mb-8 h-44'>
      <label for='message' class={formLabelClass}>Message</label>
      <textarea
        placeholder='Describe your project'
        class={formInputClass}
        id='message'
        name='message'
        cols='30'
        rows='10'
        required></textarea>
    </div>

    <Button type='submit' class='w-full sm:w-auto'>Send Message</Button>
  </form>
</div>
