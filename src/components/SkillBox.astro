---
import SkillTile from './SkillTile.astro'

interface Skill {
  name: string
  icon: string
  alticon?: string
  invertInDark?: boolean
}

interface Props {
  skills: Skill[]
  categoryIndex?: number
}

const { skills, categoryIndex = 0 }: Props = Astro.props

const marqueeDuration = `${Math.max(skills.length * 4, 28) + categoryIndex * 5}s`
const reverseMarquee = categoryIndex % 2 === 1
const marqueeSkills = [...skills, ...skills]
---

<div
  class='overflow-hidden mask-[linear-gradient(90deg,transparent,#000_12%,#000_88%,transparent)] motion-reduce:scrollbar-thin motion-reduce:overflow-x-auto motion-reduce:mask-none'
  style={`--skills-marquee-duration: ${marqueeDuration}`}
>
  <div
    class:list={[
      'flex w-max gap-6 motion-reduce:animate-none',
      'animate-[skills-marquee_var(--skills-marquee-duration)_linear_infinite]',
      '[&:has(.skill-tile:hover)]:[animation-play-state:paused]',
      reverseMarquee && '[animation-direction:reverse]',
    ]}
  >
    {
      marqueeSkills.map((skill, index) => (
        <SkillTile
          name={skill.name}
          icon={skill.icon}
          alticon={skill.alticon}
          invertInDark={skill.invertInDark}
          hideFromAssistiveTech={index >= skills.length}
        />
      ))
    }
  </div>
</div>
