---
interface Props {
  title: string
  skills: {
    name: string
    icon: string
    alticon?: string
    invertInDark?: boolean
  }[]
}

const { title, skills }: Props = Astro.props
---

<div class='skills__content flex flex-col gap-y-8'>
  <h3 class='skills__title'>{title}</h3>
  <div class='skills__box flex flex-wrap justify-center gap-x-6 gap-y-6'>
    {
      skills.map((skill) => (
        <div id={skill.name} class='skills__data group flex w-14 flex-col items-center gap-1.5'>
          <img
            loading='lazy'
            data-icon={skill.icon}
            data-alticon={skill.alticon}
            src={skill.icon}
            alt=''
            class:list={[
              'size-10 drop-shadow-sm group-hover:drop-shadow-xl',
              skill.invertInDark && '[body:not(.light-theme)_&]:brightness-0 [body:not(.light-theme)_&]:invert',
            ]}
          />
          <span class='w-full text-center text-(length:--tiny-font-size) leading-tight text-(--text-color-light)'>
            {skill.name}
          </span>
        </div>
      ))
    }
  </div>
</div>
