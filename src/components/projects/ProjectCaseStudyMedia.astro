---
import type { Project, ProjectImage } from '../../types'
import { getProjectImageSources } from '../../utils/projectImages'

interface Props {
  project: Pick<Project, 'id' | 'slug'>
  image: ProjectImage
}

const { project, image }: Props = Astro.props
const sources = getProjectImageSources(project, image.key)
---

<figure class='mt-18 lg:mt-24'>
  <picture class='border-copy-muted/10 bg-surface block aspect-video overflow-hidden rounded-2xl border shadow-[0_8px_32px_hsla(var(--second-hue),48%,8%,0.12)]'>
    <source srcset={sources.avifSrcSet} sizes='(max-width: 1024px) 100vw, 1024px' type='image/avif' />
    <source srcset={sources.webpSrcSet} sizes='(max-width: 1024px) 100vw, 1024px' type='image/webp' />
    <img
      src={sources.fallback}
      alt={image.alt}
      width={1920}
      height={1080}
      class='h-full w-full object-cover'
      loading='lazy'
      decoding='async'
    />
  </picture>

  {image.caption && (
    <figcaption class='text-copy-muted text-smaller mx-auto mt-4 max-w-2xl text-center leading-relaxed text-pretty'>
      {image.caption}
    </figcaption>
  )}
</figure>
