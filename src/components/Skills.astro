---
import { skillsData } from '../data/skills'
import SkillBox from './SkillBox.astro'
---

<section class='skills section' id='skills'>
  <span class='section__subtitle'>My Stack</span>
  <h2 class='section__title'>Skills & Technologies</h2>

  <div class='skills__container custom-container grid gap-5!'>
    {skillsData.map((item) => <SkillBox title={item.title} skills={item.skills} />)}
  </div>
</section>

<script>
  import { getTheme, subscribeToTheme } from '../lib/theme'

  function updateSkillIcons() {
    const useAltIcon = getTheme() === 'light'
    const skillIcons = document.querySelectorAll('#skills .skills__data img') as NodeListOf<HTMLImageElement>

    skillIcons.forEach((icon) => {
      icon.src = useAltIcon ? icon.getAttribute('data-alticon') || icon.src : icon.getAttribute('data-icon') || icon.src
    })
  }

  updateSkillIcons()
  subscribeToTheme(updateSkillIcons)
</script>
