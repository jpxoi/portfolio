---
import { services } from '../data/services'
import ServiceCard from './ServiceCard.astro'
---

<section class='services section'>
  <span class='section__subtitle'>My Services</span>
  <h2 class='section__title'>What I Offer</h2>

  <div class='services__container custom-container grid gap-5!'>
    {
      services.map((service) => (
        <ServiceCard title={service.title} description={service.description} items={service.items} />
      ))
    }
  </div>
</section>
<script>
  const modalViews = document.querySelectorAll('.services__modal') as NodeListOf<HTMLDivElement>
  const modalBtns = document.querySelectorAll('.services__button') as NodeListOf<HTMLButtonElement>
  const modalClose = document.querySelectorAll('.services__modal-close') as NodeListOf<HTMLButtonElement>

  let listeningForOutsideClick = false

  function hasOpenModal() {
    return [...modalViews].some((modalView) => modalView.classList.contains('active-modal'))
  }

  function syncOutsideClickListener() {
    if (hasOpenModal() && !listeningForOutsideClick) {
      document.addEventListener('click', handleOutsideClick)
      listeningForOutsideClick = true
      return
    }

    if (!hasOpenModal() && listeningForOutsideClick) {
      document.removeEventListener('click', handleOutsideClick)
      listeningForOutsideClick = false
    }
  }

  function closeAllModals() {
    modalViews.forEach((modalView) => {
      modalView.classList.remove('active-modal')
    })
    syncOutsideClickListener()
  }

  function handleOutsideClick(event: Event) {
    modalViews.forEach((modalView) => {
      if (!modalView.classList.contains('active-modal')) return

      const modalContent = modalView.querySelector('.services__modal-content')
      if (
        modalContent &&
        !modalContent.contains(event.target as Node) &&
        !(event.target as Element).closest('.services__button')
      ) {
        modalView.classList.remove('active-modal')
      }
    })

    syncOutsideClickListener()
  }

  modalBtns.forEach((button, index) => {
    button.addEventListener('click', () => {
      modalViews[index].classList.add('active-modal')
      syncOutsideClickListener()
    })
  })

  modalClose.forEach((closeButton) => {
    closeButton.addEventListener('click', closeAllModals)
  })
</script>
