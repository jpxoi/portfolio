---
import { services } from '../data/services'
import ServiceCard from './ServiceCard.astro'
import PageSection from './PageSection.astro'
import SectionHeading from './SectionHeading.astro'
import SiteContainer from './SiteContainer.astro'
---

<PageSection class='services'>
  <SectionHeading subtitle='My Services' title='What I Offer' />

  <SiteContainer class='grid grid-cols-1 gap-6 pt-4 sm:grid-cols-2 lg:grid-cols-3'>
    {
      services.map((service, index) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          items={service.items}
          modalId={`service-modal-${index}`}
        />
      ))
    }
  </SiteContainer>
</PageSection>
