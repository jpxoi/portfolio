---
import type { NavItem } from '../types'

const { route, alt, icon: Icon, defaultActive }: NavItem = Astro.props as NavItem

const classes = [
  'flex rounded-full p-2 transition-theme',
  'text-copy-muted',
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
  'hover:text-primary',
  'nav-active:bg-nav-item-active nav-active:text-primary',
  'nav-active:hover:bg-nav-item-active-hover',
  defaultActive && 'active-link',
]
  .filter(Boolean)
  .join(' ')
---

<li>
  <a href={route} class={classes} aria-label={alt} {...defaultActive && { 'aria-current': 'location' }}>
    <Icon className='size-5' color='currentColor' />
  </a>
</li>
