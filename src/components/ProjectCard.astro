---
import { Globe, Github } from '@boxicons/react'
import type { Project } from '../types'
import { getProjectImageSources } from '../utils/projectImages'

interface Props extends Project {}

const project = Astro.props
const { id, slug = id, name, tagline, description, link, github, stack, media } = project

const fullTitle = `${name} | ${tagline}`
const caseStudyPath = `/projects/${slug}`

const imageSources = getProjectImageSources(project, media.cover.key)

const imgSizes = '(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 768px'

const projectActionClass =
  'flex size-8 shrink-0 items-center justify-center rounded-md text-copy-muted transition-theme hover:bg-surface hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'

const stackTagClass =
  'inline-flex items-center rounded-sm border border-copy-muted/15 bg-surface/35 px-1.5 py-0.5 text-tiny font-normal leading-tight text-copy-muted transition-theme group-hover:border-copy-muted/25 group-hover:text-copy'
---

<article class='group flex h-full w-full flex-col gap-5'>
  <div class='flex flex-1 flex-col gap-4'>
    <a
      href={caseStudyPath}
      aria-label={`Read case study: ${fullTitle}`}
      class='aspect-video overflow-hidden rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'
    >
      <picture>
        <source srcset={imageSources.avifSrcSet} sizes={imgSizes} type='image/avif' />
        <source srcset={imageSources.webpSrcSet} sizes={imgSizes} type='image/webp' />
        <img
          src={imageSources.fallback}
          alt={media.cover.alt}
          width={1920}
          height={1080}
          class='h-full w-full scale-105 object-cover transition-transform duration-300 ease-out group-hover:scale-100'
          loading='lazy'
          decoding='async'
        />
      </picture>
    </a>

    <div class='flex flex-col gap-2'>
      <div class='flex items-start justify-between gap-3'>
        <div class='flex min-w-0 flex-col gap-0.5'>
          <h3 class='text-h3 leading-tight font-medium'>
            <a
              href={caseStudyPath}
              class='text-title hover:text-primary rounded-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary'
            >
              {name}
            </a>
          </h3>

          <p class='text-primary text-small leading-snug'>{tagline}</p>
        </div>

        {(link || github) && (
          <div class='flex shrink-0 items-center gap-0.5'>
            {link && (
              <a
                href={link}
                target='_blank'
                rel='noopener noreferrer'
                aria-label={`Open live project: ${fullTitle}`}
                class={projectActionClass}
              >
                <Globe className='size-4.5' aria-hidden='true' />
              </a>
            )}
            {github && (
              <a
                href={github}
                target='_blank'
                rel='noopener noreferrer'
                aria-label={`Open GitHub repository: ${fullTitle}`}
                class={projectActionClass}
              >
                <Github className='size-4.5' aria-hidden='true' />
              </a>
            )}
          </div>
        )}
      </div>

      <p class='text-copy-muted text-small line-clamp-3 leading-relaxed'>{description}</p>

      <ul class='flex flex-wrap gap-1.5 pt-0.5' aria-label='Technologies used'>
        {stack.map((item) => (
          <li class={stackTagClass}>{item}</li>
        ))}
      </ul>
    </div>
  </div>
</article>
