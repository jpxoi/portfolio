---
import { Globe, Github } from '@boxicons/react'
import type { Project } from '../types'
import { CDN_URL } from '../constants'

interface Props extends Project {}

const { id, name, tagline, description, link, github, stack } = Astro.props

const fullTitle = `${name} | ${tagline}`

const projectImageBase = `${CDN_URL}/projects/${id}`

const imgAvifSrcSet = [
  `${projectImageBase}/card-768.avif 768w`,
  `${projectImageBase}/card-1280.avif 1280w`,
  `${projectImageBase}/card-1920.avif 1920w`,
].join(', ')

const imgWebpSrcSet = [
  `${projectImageBase}/card-768.webp 768w`,
  `${projectImageBase}/card-1280.webp 1280w`,
  `${projectImageBase}/card-1920.webp 1920w`,
].join(', ')

const imgFallback = `${projectImageBase}/card-1920.webp`

const imgSizes = '(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 768px'

const isPrivate = !link && !github

const projectActionClass =
  'flex size-8 shrink-0 items-center justify-center rounded-md text-copy-muted transition-theme hover:bg-surface hover:text-primary'

const stackTagClass =
  'inline-flex items-center rounded-sm border border-copy-muted/15 bg-surface/35 px-1.5 py-0.5 text-tiny font-normal leading-tight text-copy-muted transition-theme group-hover:border-copy-muted/25 group-hover:text-copy'
---

<article class='group flex h-full w-full flex-col gap-5'>
  <div class='flex flex-1 flex-col gap-4'>
    <div class='aspect-video overflow-hidden rounded-lg'>
      <picture>
        <source srcset={imgAvifSrcSet} sizes={imgSizes} type='image/avif' />
        <source srcset={imgWebpSrcSet} sizes={imgSizes} type='image/webp' />
        <img
          src={imgFallback}
          alt={fullTitle}
          width={1920}
          height={1080}
          class='h-full w-full scale-105 object-cover transition-transform duration-300 ease-out group-hover:scale-100'
          loading='lazy'
          decoding='async'
        />
      </picture>
    </div>

    <div class='flex flex-col gap-2'>
      <div class='flex items-start justify-between gap-3'>
        <div class='flex min-w-0 flex-col gap-0.5'>
          <div class='flex flex-wrap items-center gap-x-2 gap-y-1'>
            <h3 class='text-title text-h3 leading-tight font-medium'>
              {name}
            </h3>
            {
              isPrivate && (
                <span class='border-copy-muted/25 text-copy-muted text-tiny inline-flex shrink-0 items-center rounded-full border px-2 py-0.5 leading-none font-medium'>
                  Private
                </span>
              )
            }
          </div>

          <p class='text-primary text-small leading-snug'>{tagline}</p>
        </div>

        {
          (link || github) && (
            <div class='flex shrink-0 items-center gap-0.5'>
              {link && (
                <a
                  href={link}
                  target='_blank'
                  rel='noopener noreferrer'
                  aria-label={`Open live project: ${fullTitle}`}
                  class={projectActionClass}
                >
                  <Globe className='size-4.5' aria-hidden='true' />
                </a>
              )}
              {github && (
                <a
                  href={github}
                  target='_blank'
                  rel='noopener noreferrer'
                  aria-label={`Open GitHub repository: ${fullTitle}`}
                  class={projectActionClass}
                >
                  <Github className='size-4.5' aria-hidden='true' />
                </a>
              )}
            </div>
          )
        }
      </div>

      <p class='text-copy-muted text-small line-clamp-4 leading-relaxed'>
        {description}
      </p>

      <ul class='flex flex-wrap gap-1.5 pt-0.5' aria-label='Technologies used'>
        {stack.map((item) => <li class={stackTagClass}>{item}</li>)}
      </ul>
    </div>
  </div>
</article>
