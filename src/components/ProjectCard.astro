---
import { Globe, Github } from '@boxicons/react'
import type { Project } from '../types'
import { CDN_URL } from '../constants'

interface Props extends Project {}

const { id, name, tagline, description, link, github, stack } = Astro.props

const fullTitle = `${name} | ${tagline}`

const imgAvif = `${CDN_URL}/projects/${id}/card.avif`
const imgWebp = `${CDN_URL}/projects/${id}/card.webp`
const imgFallback = imgWebp

const isPrivate = !link && !github

const projectActionClass =
  'flex size-8 shrink-0 items-center justify-center rounded-md text-(--text-color-light) transition-theme [@media(hover:hover)]:hover:bg-(--container-color) [@media(hover:hover)]:hover:text-(--first-color)'

const stackTagClass =
  'inline-flex items-center rounded-sm border border-(--text-color-light)/15 bg-(--container-color)/35 px-1.5 py-0.5 text-(length:--tiny-font-size) font-normal leading-tight text-(--text-color-light) transition-theme [@media(hover:hover)]:group-hover:border-(--text-color-light)/25 [@media(hover:hover)]:group-hover:text-(--text-color)'
---

<article class='group project__card flex h-full w-full flex-col gap-5'>
  <div class='flex flex-1 flex-col gap-4'>
    <div class='aspect-video overflow-hidden rounded-lg'>
      <picture>
        <source srcset={imgAvif} type='image/avif' />
        <source srcset={imgWebp} type='image/webp' />
        <img
          src={imgFallback}
          alt={fullTitle}
          width={1920}
          height={1080}
          class='h-full w-full object-cover transition-transform duration-300 ease-out [@media(hover:hover)]:group-hover:scale-105'
          loading='lazy'
        />
      </picture>
    </div>

    <div class='flex flex-col gap-2'>
      <div class='flex items-start justify-between gap-3'>
        <div class='flex min-w-0 flex-col gap-0.5'>
          <div class='flex flex-wrap items-center gap-x-2 gap-y-1'>
            <h3 class='text-(length:--h3-font-size) leading-tight font-medium text-(--title-color)'>
              {name}
            </h3>
            {
              isPrivate && (
                <span class='inline-flex shrink-0 items-center rounded-full border border-(--text-color-light)/25 px-2 py-0.5 text-(length:--tiny-font-size) leading-none font-medium text-(--text-color-light)'>
                  Private
                </span>
              )
            }
          </div>

          <p class='text-(length:--small-font-size) leading-snug text-(--first-color)'>{tagline}</p>
        </div>

        {
          (link || github) && (
            <div class='flex shrink-0 items-center gap-0.5'>
              {link && (
                <a
                  href={link}
                  target='_blank'
                  rel='noopener noreferrer'
                  aria-label={`Open live project: ${fullTitle}`}
                  class={projectActionClass}
                >
                  <Globe className='size-[1.125rem]' aria-hidden='true' />
                </a>
              )}
              {github && (
                <a
                  href={github}
                  target='_blank'
                  rel='noopener noreferrer'
                  aria-label={`Open GitHub repository: ${fullTitle}`}
                  class={projectActionClass}
                >
                  <Github className='size-[1.125rem]' aria-hidden='true' />
                </a>
              )}
            </div>
          )
        }
      </div>

      <p class='line-clamp-4 text-(length:--small-font-size) leading-relaxed text-(--text-color-light)'>
        {description}
      </p>

      <ul class='flex flex-wrap gap-1.5 pt-0.5' aria-label='Technologies used'>
        {stack.map((item) => <li class={stackTagClass}>{item}</li>)}
      </ul>
    </div>
  </div>
</article>
