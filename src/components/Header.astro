---
interface Props {
  variant?: 'default' | 'alt'
}

const { variant = 'default' }: Props = Astro.props
import NavLogo from './NavLogo.astro'
import NavMenu from './NavMenu.astro'
import ThemeToggle from './ThemeToggle.astro'
---

<header class='transition-theme bg-page fixed top-0 left-0 z-100 w-full shadow-none' id='header'>
  <nav class='h-header lg:h-header-lg mx-auto flex w-full max-w-5xl items-center justify-between px-4 lg:grid lg:grid-cols-[1fr_auto_1fr]'>
    <NavLogo variant={variant} className='h-3.5' />
    {variant === 'default' && <NavMenu />}
    <div class='justify-self-end'>
      <ThemeToggle />
    </div>
  </nav>
</header>
<script>
  import { initHeaderActiveLink } from '../lib/header'
  initHeaderActiveLink()
</script>
