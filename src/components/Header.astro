---
interface Props {
  variant?: 'default' | 'alt'
}

const { variant = 'default' }: Props = Astro.props
import NavLogo from './NavLogo.astro'
import NavMenu from './NavMenu.astro'
import ThemeToggle from './ThemeToggle.astro'
---

<header class='transition-theme bg-page fixed top-0 left-0 z-100 w-full shadow-none' id='header'>
  <nav class='nav mx-auto w-full max-w-5xl px-4'>
    <NavLogo variant={variant} className='h-3.5' />
    {variant === 'default' ? <NavMenu /> : null}
    <ThemeToggle />
  </nav>
</header>
<script>
  const navMenu = document.querySelector('.nav__menu')
  const sections = navMenu ? (document.querySelectorAll('section[id]') as NodeListOf<HTMLElement>) : null
  const navLinks = navMenu
    ? new Map(
        [...navMenu.querySelectorAll('a[href^="#"]')]
          .map((link) => {
            const id = link.getAttribute('href')?.slice(1)
            return id ? ([id, link] as const) : null
          })
          .filter((entry): entry is [string, HTMLAnchorElement] => entry !== null),
      )
    : null

  let ticking = false

  function updateOnScroll() {
    if (sections && navLinks) {
      const scrollY = window.scrollY

      for (const section of sections) {
        const sectionId = section.id
        const link = navLinks.get(sectionId)
        if (!link) continue

        const sectionTop = section.offsetTop - 58
        const sectionBottom = sectionTop + section.offsetHeight

        link.classList.toggle('active-link', scrollY > sectionTop && scrollY <= sectionBottom)
      }
    }

    ticking = false
  }

  function requestScrollUpdate() {
    if (ticking) return
    ticking = true
    requestAnimationFrame(updateOnScroll)
  }

  requestScrollUpdate()
  window.addEventListener('scroll', requestScrollUpdate, { passive: true })
</script>
